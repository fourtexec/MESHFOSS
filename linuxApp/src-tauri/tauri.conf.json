{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MESHFOSS",
  "version": "2.0.0",
  "identifier": "ru.meshfoss.desktop",
  "build": {
    "beforeDevCommand": "trunk serve ui/index.html --port 1420 --address 127.0.0.1",
    "beforeBuildCommand": "trunk build ui/index.html --release",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"МЭШ · MESHFOSS","width":1240,"height":800,"minWidth":480,"minHeight":440}],
    "security": {"csp":"default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"}
  },
  "bundle": {
    "active": true, "targets": ["deb", "appimage"], "category":"Education",
    "shortDescription": "Дневник Московской электронной школы",
    "longDescription": "Расписание, домашние задания, оценки, рейтинг и питание МЭШ.",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/icon.png"],
    "linux":{"deb":{"section":"education"}}
  }
}
